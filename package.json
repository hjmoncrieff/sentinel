{
  "name": "sentinel",
  "version": "1.0.0",
  "description": "SENTINEL is a research platform for tracking civil-military relations, political stability, and regional security events across Latin America and the Caribbean. It combines automated event ingestion with analyst review and publishes a public-facing static dashboard.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "serve": "python3 -m http.server 8000",
    "playwright:install": "playwright install chromium",
    "smoke:dashboard": "node scripts/dev/playwright_smoke_dashboard.mjs",
    "lint:python": "ruff check scripts",
    "format:python": "ruff format scripts",
    "typecheck:python": "basedpyright scripts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:status:env": "supabase status -o env",
    "supabase:db:reset": "supabase db reset --local",
    "supabase:db:push:local": "supabase db push --local",
    "test": "npm run smoke:dashboard",
    "analyst-console:dev": "vite --config vite.config.ts",
    "analyst-console:build": "vite build --config vite.config.ts",
    "analyst-console:preview": "vite preview --config vite.config.ts",
    "analyst-console:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "analyst-console:storybook:build": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "analyst-console:typecheck": "tsc --noEmit -p tsconfig.json",
    "analyst-console:test": "vitest run",
    "analyst-console:test:watch": "vitest",
    "analyst-console:test:e2e": "playwright test",
    "analyst-console:test:visual": "playwright test tests/analyst-console/visual.spec.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjmoncrieff/sentinel.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/hjmoncrieff/sentinel/issues"
  },
  "homepage": "https://github.com/hjmoncrieff/sentinel#readme",
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "@supabase/supabase-js": "^2.86.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^27.0.1",
    "lucide-react": "^0.552.0",
    "playwright": "^1.60.0",
    "storybook": "^8.6.14",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.1",
    "vitest": "^4.0.8"
  }
}
