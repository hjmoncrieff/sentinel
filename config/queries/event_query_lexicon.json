{
  "version": "1.0",
  "updated": "2026-06-02",
  "status": "design_ready_not_yet_wired",
  "owner": "SENTINEL retrieval pipeline",
  "purpose": "Central multilingual query lexicon for article discovery, retrieval filtering, and future source-specific query assembly across civil-military relations, democratic erosion, armed conflict, and transnational security in Latin America and the Caribbean.",
  "design_principles": [
    "Keep retrieval tied to SENTINEL event taxonomy rather than a flat bag of words.",
    "Separate discovery breadth from pre-filter precision and verification logic.",
    "Use geography plus event-family terms as the default retrieval spine.",
    "Elevate state-security institutions, armed-group aliases, and organized-crime brands because they often carry more signal than generic words like military or security.",
    "Support English, Spanish, and Portuguese directly rather than relying on translation at query time.",
    "Reserve narrower country-specific expansions for the highest-priority cases instead of bloating every global query."
  ],
  "retrieval_layers": {
    "discovery": {
      "description": "Broad, recall-oriented query layer for Google News, NewsAPI, and other search products.",
      "default_logic": "At least one event-family family plus geography tokens."
    },
    "prefilter": {
      "description": "Cheap relevance screen before model classification.",
      "default_logic": "Weighted scoring across family terms, actor aliases, institution aliases, and geography, with penalties for known false-positive domains."
    },
    "verification": {
      "description": "Narrower query layer for wire and corroboration sources.",
      "default_logic": "Prioritize high-signal incident terms, named actors, and strong geography."
    },
    "enrichment": {
      "description": "Slower analytical layer for context, oversight, and human-rights reporting.",
      "default_logic": "Allow wider reform, accountability, and democratic-erosion vocabulary."
    }
  },
  "monitor_layers": {
    "organized_crime_violence_illicit_economies": {
      "description": "Dedicated retrieval layer for criminal violence, trafficking corridors, prison power, illicit extraction, extortion systems, and criminal governance that shape civil-military order.",
      "why_it_matters": [
        "In much of the region, organized crime is not just a public-safety issue but a driver of coercive governance, military deployment, and territorial control.",
        "Illicit economies often generate the strongest pressure on civil-military relations through corruption, intelligence cooperation, emergency rule, and hybrid state-criminal bargains.",
        "This layer should catch violence and extraction signals even when articles do not use explicit civil-military language."
      ],
      "primary_query_families": [
        "organized_crime_and_transnational_security",
        "criminal_violence_and_illicit_economies",
        "corruption_capture_and_judicial_pressure",
        "border_tension_and_sovereignty"
      ],
      "priority_countries": [
        "Brazil",
        "Colombia",
        "Ecuador",
        "El Salvador",
        "Haiti",
        "Honduras",
        "Mexico",
        "Peru",
        "Venezuela"
      ]
    }
  },
